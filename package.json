{
  "name": "ember-hollow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ember Hollow - a 3D farming and life-simulation game",
  "scripts": {
    "dev": "vite --port 5170 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5170 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "three": "^0.171.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/three": "^0.171.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.5",
    "vitest": "^3.0.4"
  }
}