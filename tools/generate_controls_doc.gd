extends SceneTree
## Generates docs/CONTROLS.md from the real project InputMap. Run:
##   Godot --headless --path . --script res://tools/generate_controls_doc.gd
## The document is never hand-edited: the input map is generated by
## tools/rebuild_input_map.gd, so this reads the same source of truth.

const OUTPUT := "res://docs/CONTROLS.md"
## Actions deliberately available on keyboard/mouse only. Menus holding these
## are pad-navigable through focus; the direct shortcut is a convenience.
const KEYBOARD_ONLY: Array[StringName] = [
	InputActions.CRAFT, InputActions.BUILD, InputActions.BUILDINGS,
	InputActions.SETTINGS, InputActions.SAVE_GAME, InputActions.LOAD_GAME,
	InputActions.TOGGLE_LOG_PANEL, InputActions.JUKEBOX,
	InputActions.HOTBAR_1, InputActions.HOTBAR_2, InputActions.HOTBAR_3,
	InputActions.HOTBAR_4, InputActions.HOTBAR_5, InputActions.HOTBAR_6,
	InputActions.HOTBAR_7, InputActions.HOTBAR_8, InputActions.HOTBAR_9,
]

const CORE_LOOP := [
	["Move", "W A S D / arrows", "Left stick"],
	["Look", "Mouse", "Right stick"],
	["Jump", "Space", "A"],
	["Interact", "E", "X"],
	["Use held item", "Left click", "RT"],
	["Alt-use / place / cancel", "Right click", "LT"],
	["Hotbar", "1-9 / wheel", "D-pad left / right"],
	["Menu / back", "Esc / B", "Start / B"],
]


func _initialize() -> void:
	var out := PackedStringArray()
	out.append("# Controls\n")
	out.append("Generated by `tools/generate_controls_doc.gd` from the project InputMap. ")
	out.append("Do not edit by hand — change `scripts/core/input_actions.gd` and ")
	out.append("`tools/rebuild_input_map.gd`, then re-run the generator.\n")
	out.append("---\n")
	out.append("## The eight-input core loop\n")
	out.append("| Action | Keyboard / mouse | Gamepad |")
	out.append("| --- | --- | --- |")
	for row: Array in CORE_LOOP:
		out.append("| %s | %s | %s |" % [row[0], row[1], row[2]])
	out.append("\nK stays a keyboard attack alias; V switches camera; Tab or I opens")
	out.append("the inventory; J opens the journal. Esc or B always backs out, Enter,")
	out.append("E or A always confirms, and every menu works by mouse, keyboard and")
	out.append("gamepad focus.\n")
	out.append("---\n")
	out.append("## All actions\n")
	out.append("| Action | Keyboard / mouse | Gamepad |")
	out.append("| --- | --- | --- |")

	var names: Array[String] = []
	for action: String in InputMap.get_actions():
		if not action.begins_with("ui_"):
			names.append(action)
	names.sort()
	for action: String in names:
		var keyboard: Array[String] = []
		var mouse: Array[String] = []
		var pad: Array[String] = []
		for event: InputEvent in InputMap.action_get_events(action):
			if event is InputEventKey:
				var key := event as InputEventKey
				var code := key.physical_keycode if key.physical_keycode != 0 else key.keycode
				keyboard.append(OS.get_keycode_string(code))
			elif event is InputEventMouseButton:
				mouse.append(_mouse_name((event as InputEventMouseButton).button_index))
			elif event is InputEventJoypadButton:
				pad.append("Btn %d" % (event as InputEventJoypadButton).button_index)
			elif event is InputEventJoypadMotion:
				var motion := event as InputEventJoypadMotion
				pad.append("Axis %d %s" % [motion.axis, "+" if motion.axis_value > 0 else "-"])
		var kb_parts: Array[String] = []
		kb_parts.append_array(keyboard)
		kb_parts.append_array(mouse)
		var kb := ", ".join(kb_parts) if not kb_parts.is_empty() else "—"
		var gp := ", ".join(pad) if not pad.is_empty() else "keyboard-only"
		out.append("| `%s` | %s | %s |" % [action, kb, gp])

	out.append("\n---\n")
	out.append("## Keyboard-only actions\n\n")
	for action: StringName in KEYBOARD_ONLY:
		var reason := "reachable on a pad through menu focus"
		if String(action).begins_with("hotbar_"):
			reason = "reached on a pad with D-pad left / right (next / prev slot)"
		out.append("- `%s` — %s" % [action, reason])
	out.append("\nDeviations from this table are allowed only when recorded here with a")
	out.append("reason; regenerate after any input-map change.\n")

	var file := FileAccess.open(OUTPUT, FileAccess.WRITE)
	if file == null:
		printerr("[generate_controls_doc] cannot write %s" % OUTPUT)
		quit(1)
		return
	file.store_string("\n".join(out))
	file.close()
	print("[generate_controls_doc] wrote %s (%d actions)" % [OUTPUT, names.size()])
	quit(0)


func _mouse_name(index: int) -> String:
	match index:
		MOUSE_BUTTON_LEFT:
			return "Left click"
		MOUSE_BUTTON_RIGHT:
			return "Right click"
		MOUSE_BUTTON_MIDDLE:
			return "Middle click"
		MOUSE_BUTTON_WHEEL_UP:
			return "Wheel up"
		MOUSE_BUTTON_WHEEL_DOWN:
			return "Wheel down"
	return "Mouse %d" % index
