<Project Sdk="Godot.NET.Sdk/4.5.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Hollowbrook</RootNamespace>
    <AssemblyName>Hollowbrook</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <GodotBin Condition="'$(GodotBin)' == ''">$(MSBuildThisFileDirectory)tools/Godot_v4.5-stable_mono_win64.exe</GodotBin>
  </PropertyGroup>
  <!-- The clickable Windows launcher is a separate .NET project. It must not be
       compiled into the Godot game assembly. -->
  <ItemGroup>
    <Compile Remove="launcher/**/*.cs" />
  </ItemGroup>
</Project>
