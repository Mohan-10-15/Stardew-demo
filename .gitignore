# Godot 4
.godot/
.import/
export.cfg
export_presets.cfg

# Build output
build/
bin/
*.tmp

# Portable Godot editor binaries (ship in the repo, git-ignored)
tools/*.exe
tools/*.zip

# Godot Mono / C# (unused for GDScript, kept as a guard)
.mono/
data_*/
mono_crash.*.json

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vs/
.vscode/
.idea/
*.swp
# Screenshots written by tools/capture_*.gd for visual review. Not game assets.
# The `.import` sidecar has to be ignored too, or Godot's importer metadata for a
# file that is not in the repository is the one thing that gets committed.
art_review_*.png
art_review_*.png.import
