<?xml version="1.0" encoding="utf-8"?>
<!--
  Godot.NET.Sdk and GodotSharp are restored from the packages the engine itself
  ships, under tools/GodotSharp/Tools. That makes the C# build work offline and
  pins the SDK to the exact engine version in use: a mismatch between
  Godot.NET.Sdk and the editor is the single most common way a Godot .NET
  project stops compiling.

  nuget.org stays listed for ordinary libraries. Nothing in the project
  currently depends on it.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-shipped" value="tools/GodotSharp/Tools" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
