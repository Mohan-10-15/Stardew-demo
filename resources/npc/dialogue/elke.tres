[sub_resource type="Resource" id="Resource_dnh4k"]
script = ExtResource("1_ik4tw")
id = &"intro"
text = "Elke. Maps. Mine are mostly right, which is more than you will get elsewhere."
once = true
set_flags = Array[StringName]([&"met_elke"])

[sub_resource type="Resource" id="Resource_4i27d"]
script = ExtResource("1_ik4tw")
id = &"greeting"
text = "If you are lost, you are probably standing on a road I drew last week."

[sub_resource type="Resource" id="Resource_prnk1"]
script = ExtResource("1_ik4tw")
id = &"morning"
text = "Elke is up before the shop and has opinions about it."
hour_from = 6
hour_to = 10

[sub_resource type="Resource" id="Resource_b7cfq"]
script = ExtResource("1_ik4tw")
id = &"evening"
text = "Elke looks at the light and decides the day was mostly fine."
hour_from = 17
hour_to = 22

[sub_resource type="Resource" id="Resource_wrbnr"]
script = ExtResource("1_ik4tw")
id = &"night"
text = "Elke should be asleep. Elke is not."
hour_from = 23
hour_to = 5
mood = &"sad"

[sub_resource type="Resource" id="Resource_mfy27"]
script = ExtResource("1_ik4tw")
id = &"rain"
text = "Elke says the rain has excellent timing and means the opposite."
weather = 1

[sub_resource type="Resource" id="Resource_6pmog"]
script = ExtResource("1_ik4tw")
id = &"snow"
text = "Elke thinks the whole valley looks better under a clean sheet."
weather = 3

[sub_resource type="Resource" id="Resource_6owaf"]
script = ExtResource("1_ik4tw")
id = &"spring"
text = "Elke has a list for spring and has already lost it."
season = 0

[sub_resource type="Resource" id="Resource_5cm4o"]
script = ExtResource("1_ik4tw")
id = &"summer"
text = "Elke says the heat makes everything honest, including people."
season = 1

[sub_resource type="Resource" id="Resource_ckrdp"]
script = ExtResource("1_ik4tw")
id = &"fall"
text = "Elke says the valley gets itself ready and someone has to check."
season = 2

[sub_resource type="Resource" id="Resource_1pk3g"]
script = ExtResource("1_ik4tw")
id = &"winter"
text = "Elke plans to do everything next year, at length, indoors."
season = 3

[sub_resource type="Resource" id="Resource_f7m5p"]
script = ExtResource("1_ik4tw")
id = &"friend_2"
text = "Elke would say you are growing on them, but not in the garden."
min_hearts = 2
mood = &"happy"

[sub_resource type="Resource" id="Resource_ti1cv"]
script = ExtResource("1_ik4tw")
id = &"friend_4"
text = "Elke says you are the rare sort who stays for the dull parts."
min_hearts = 4
mood = &"happy"

[sub_resource type="Resource" id="Resource_agmud"]
script = ExtResource("2_cw1v3")
text = "Any mistakes?"
next = &"story_2"

[sub_resource type="Resource" id="Resource_awypk"]
script = ExtResource("2_cw1v3")
text = "I do not want to know."
set_flags = Array[StringName]([&"elke_dodged"])

[sub_resource type="Resource" id="Resource_qd8iv"]
script = ExtResource("1_ik4tw")
id = &"story_1"
text = "I mapped the whole valley in a night, by starlight and stubbornness."
requires_flag = &"met_elke"
once = true
choices = Array[ExtResource("2_cw1v3")]([SubResource("Resource_agmud"), SubResource("Resource_awypk")])

[sub_resource type="Resource" id="Resource_aa1as"]
script = ExtResource("1_ik4tw")
id = &"story_2"
text = "One. I drew the pond a metre too far east. I have never lived it down."
mood = &"happy"
requires_flag = &"met_elke"
once = true
hearts = 1
set_flags = Array[StringName]([&"elke_beat"])

[sub_resource type="Resource" id="Resource_i81ii"]
script = ExtResource("1_ik4tw")
id = &"dating"
text = "I drew a map of where we walk together. It is the only one I have never wanted to correct."
min_romance = 1
mood = &"happy"

[sub_resource type="Resource" id="Resource_p0k1b"]
script = ExtResource("1_ik4tw")
id = &"married"
text = "Every road on my map ends here now. I suppose that is what home means."
min_romance = 2
mood = &"happy"

