[sub_resource type="Resource" id="Resource_j280j"]
script = ExtResource("1_v24c3")
id = &"intro"
text = "Garrick. Pumpkins. The big ones, if you are asking."
once = true
set_flags = Array[StringName]([&"met_garrick"])

[sub_resource type="Resource" id="Resource_tplp2"]
script = ExtResource("1_v24c3")
id = &"greeting"
text = "A good pumpkin takes all season and no advice whatsoever."

[sub_resource type="Resource" id="Resource_8qavb"]
script = ExtResource("1_v24c3")
id = &"morning"
text = "Garrick is up before the shop and has opinions about it."
hour_from = 6
hour_to = 10

[sub_resource type="Resource" id="Resource_cewrs"]
script = ExtResource("1_v24c3")
id = &"evening"
text = "Garrick looks at the light and decides the day was mostly fine."
hour_from = 17
hour_to = 22

[sub_resource type="Resource" id="Resource_50d8k"]
script = ExtResource("1_v24c3")
id = &"night"
text = "Garrick should be asleep. Garrick is not."
hour_from = 23
hour_to = 5

[sub_resource type="Resource" id="Resource_ec3ki"]
script = ExtResource("1_v24c3")
id = &"rain"
text = "Garrick says the rain has excellent timing and means the opposite."
weather = 1

[sub_resource type="Resource" id="Resource_uenx0"]
script = ExtResource("1_v24c3")
id = &"snow"
text = "Garrick thinks the whole valley looks better under a clean sheet."
weather = 3

[sub_resource type="Resource" id="Resource_ndn0r"]
script = ExtResource("1_v24c3")
id = &"spring"
text = "Garrick has a list for spring and has already lost it."
season = 0

[sub_resource type="Resource" id="Resource_7ecmt"]
script = ExtResource("1_v24c3")
id = &"summer"
text = "Garrick says the heat makes everything honest, including people."
season = 1

[sub_resource type="Resource" id="Resource_5m745"]
script = ExtResource("1_v24c3")
id = &"fall"
text = "Garrick says the valley gets itself ready and someone has to check."
season = 2

[sub_resource type="Resource" id="Resource_pppas"]
script = ExtResource("1_v24c3")
id = &"winter"
text = "Garrick plans to do everything next year, at length, indoors."
season = 3

[sub_resource type="Resource" id="Resource_curao"]
script = ExtResource("1_v24c3")
id = &"friend_2"
text = "Garrick would say you are growing on them, but not in the garden."
min_hearts = 2

[sub_resource type="Resource" id="Resource_fwtt6"]
script = ExtResource("1_v24c3")
id = &"friend_4"
text = "Garrick says you are the rare sort who stays for the dull parts."
min_hearts = 4

[sub_resource type="Resource" id="Resource_ayfel"]
script = ExtResource("2_d2yan")
text = "Where is it now?"
next = &"story_2"

[sub_resource type="Resource" id="Resource_c1e3q"]
script = ExtResource("2_d2yan")
text = "That is a long story."
set_flags = Array[StringName]([&"garrick_dodged"])

[sub_resource type="Resource" id="Resource_ghhnb"]
script = ExtResource("1_v24c3")
id = &"story_1"
text = "I grew a pumpkin that took two people and a cart to move."
requires_flag = &"met_garrick"
once = true
choices = Array[ExtResource("2_d2yan")]([SubResource("Resource_ayfel"), SubResource("Resource_c1e3q")])

[sub_resource type="Resource" id="Resource_fbjfm"]
script = ExtResource("1_v24c3")
id = &"story_2"
text = "It is in the field, where it belongs. I am not going to eat a landmark."
requires_flag = &"met_garrick"
once = true
hearts = 1
set_flags = Array[StringName]([&"garrick_beat"])

[sub_resource type="Resource" id="Resource_uqbl1"]
script = ExtResource("1_v24c3")
id = &"dating"
text = "I entered my biggest pumpkin in a contest this year. It came second. You came first, which surprised me more."
min_romance = 1

[sub_resource type="Resource" id="Resource_sfh55"]
script = ExtResource("1_v24c3")
id = &"married"
text = "We planted a row together this spring. I already know which one is ours."
min_romance = 2

