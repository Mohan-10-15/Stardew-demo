[ext_resource type="Script" path="res://scripts/dialogue/dialogue_tree.gd" id="3_5hfho"]

[sub_resource type="Resource" id="Resource_y4r3q"]
script = ExtResource("1_38d8u")
id = &"intro"
text = "Lyra. Things work better when they are done properly. I will show you."
once = true
set_flags = Array[StringName]([&"met_lyra"])

[sub_resource type="Resource" id="Resource_pisc0"]
script = ExtResource("1_38d8u")
id = &"greeting"
text = "There is a right way to mend a gate, and about nine ways that hold until Tuesday."

[sub_resource type="Resource" id="Resource_8n4pa"]
script = ExtResource("1_38d8u")
id = &"morning"
text = "Lyra is up before the shop and has opinions about it."
hour_from = 6
hour_to = 10

[sub_resource type="Resource" id="Resource_h7ulw"]
script = ExtResource("1_38d8u")
id = &"evening"
text = "Lyra looks at the light and decides the day was mostly fine."
hour_from = 17
hour_to = 22

[sub_resource type="Resource" id="Resource_ch1gn"]
script = ExtResource("1_38d8u")
id = &"night"
text = "Lyra should be asleep. Lyra is not."
hour_from = 23
hour_to = 5
mood = &"sad"

[sub_resource type="Resource" id="Resource_jhj0y"]
script = ExtResource("1_38d8u")
id = &"rain"
text = "Lyra says the rain has excellent timing and means the opposite."
weather = 1

[sub_resource type="Resource" id="Resource_ce3t0"]
script = ExtResource("1_38d8u")
id = &"snow"
text = "Lyra thinks the whole valley looks better under a clean sheet."
weather = 3

[sub_resource type="Resource" id="Resource_tj4sx"]
script = ExtResource("1_38d8u")
id = &"spring"
text = "Lyra has a list for spring and has already lost it."
season = 0

[sub_resource type="Resource" id="Resource_jegvw"]
script = ExtResource("1_38d8u")
id = &"summer"
text = "Lyra says the heat makes everything honest, including people."
season = 1

[sub_resource type="Resource" id="Resource_o0rkw"]
script = ExtResource("1_38d8u")
id = &"fall"
text = "Lyra says the valley gets itself ready and someone has to check."
season = 2

[sub_resource type="Resource" id="Resource_dkor7"]
script = ExtResource("1_38d8u")
id = &"winter"
text = "Lyra plans to do everything next year, at length, indoors."
season = 3

[sub_resource type="Resource" id="Resource_qgrsl"]
script = ExtResource("1_38d8u")
id = &"friend_2"
text = "Lyra would say you are growing on them, but not in the garden."
min_hearts = 2
mood = &"happy"

[sub_resource type="Resource" id="Resource_5iqap"]
script = ExtResource("1_38d8u")
id = &"friend_4"
text = "Lyra says you are the rare sort who stays for the dull parts."
min_hearts = 4
mood = &"happy"

[sub_resource type="Resource" id="Resource_4r63t"]
script = ExtResource("2_nsytc")
text = "Did it hold?"
next = &"story_2"

[sub_resource type="Resource" id="Resource_f20nt"]
script = ExtResource("2_nsytc")
text = "I am sure you did your best."
set_flags = Array[StringName]([&"lyra_dodged"])

[sub_resource type="Resource" id="Resource_viqpc"]
script = ExtResource("1_38d8u")
id = &"story_1"
text = "I rebuilt the north fence in a day, properly, with proper posts."
requires_flag = &"met_lyra"
once = true
choices = Array[ExtResource("2_nsytc")]([SubResource("Resource_4r63t"), SubResource("Resource_f20nt")])

[sub_resource type="Resource" id="Resource_5lg3y"]
script = ExtResource("1_38d8u")
id = &"story_2"
text = "It held. Then Sable came past and said 'almost'. Next spring I will show her."
mood = &"happy"
requires_flag = &"met_lyra"
once = true
hearts = 1
set_flags = Array[StringName]([&"lyra_beat"])

[sub_resource type="Resource" id="Resource_pcmfc"]
script = ExtResource("1_38d8u")
id = &"dating"
text = "I have checked and rechecked, and there is no proper way to say this except plainly. I like you."
min_romance = 1
mood = &"happy"

[sub_resource type="Resource" id="Resource_wkbai"]
script = ExtResource("1_38d8u")
id = &"married"
text = "I fixed everything in this house that was wrong. Then I stopped, because there was nothing left to improve."
min_romance = 2
mood = &"happy"

