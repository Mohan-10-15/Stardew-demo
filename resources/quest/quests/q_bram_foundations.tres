[gd_resource type="Resource" script_class="QuestData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/quest/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/quest/quest_objective.gd" id="2_objective"]
[ext_resource type="Script" path="res://scripts/quest/quest_reward.gd" id="3_reward"]
[ext_resource type="Script" path="res://scripts/quest/quest_heart_reward.gd" id="4_heart"]

[sub_resource type="Resource" id="Resource_objective"]
script = ExtResource("2_objective")
kind = &"collect"
item_id = &"stone"
count = 15

[sub_resource type="Resource" id="Resource_heart"]
script = ExtResource("4_heart")
npc = &"bram"
amount = 1

[sub_resource type="Resource" id="Resource_reward"]
script = ExtResource("3_reward")
gold = 280
items = Array[StringName]([&"wild_berry"])
item_amount = 2
hearts = Array[ExtResource("4_heart")]([SubResource("Resource_heart")])

[resource]
script = ExtResource("1_quest")
id = &"q_bram_foundations"
title = "Foundations"
description = "Bram is building something that will not fall down, which is his entire personality. He needs the footing before he will admit what it is."
giver = &"bram"
objective = SubResource("Resource_objective")
reward = SubResource("Resource_reward")
repeats = &"once"