; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hollowbrook Hollow"
config/description="A stylized 3D farming / life-simulation game with first- and third-person cameras."
config/version="0.1.0"
run/main_scene="res://scenes/core/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.09, 0.12, 0.16, 1)
boot_splash/show_image=false

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
Log="*res://scripts/core/log.gd"
Config="*res://scripts/core/config_service.gd"
GameState="*res://scripts/core/game_state.gd"
Debug="*res://scripts/core/debug_service.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Hollowbrook"

[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/default_font_multichannel_signed_distance_field=true

